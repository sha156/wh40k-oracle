# .env.example —— 复制成 .env 后填值（.env 已 gitignore，绝不提交）
#
#   cp .env.example .env
#   docker compose up -d
#
# 这份文件同时被 docker compose（变量替换）和本地 python-dotenv 读取。

# ── LLM ──────────────────────────────────────────────────────────
# 不填也能起：后端走诚实降级（明说未配置 LLM），图鉴/模拟器/军表三个页签
# 是纯引擎计算、零 LLM，照常可用。
DEEPSEEK_API_KEY=
WEB_API_LLM_PROVIDER=DeepSeek
# 走 classic Streamlit 界面的 zhipu / OpenAI 兼容通道时才需要
OPENAI_API_KEY=

# ── CORS 白名单（逗号分隔）──────────────────────────────────────
WEB_API_CORS=http://localhost:3000,http://127.0.0.1:3000

# ── 限流（次/分钟，0=关闭）──────────────────────────────────────
# heavy 档覆盖 /chat、/simulate、/roster/critique（花钱或吃 CPU 的重活）
WEB_API_RATE_LIMIT_PER_MIN=120
WEB_API_HEAVY_RATE_LIMIT_PER_MIN=20
# 仅当确实架在自己的反向代理后面才设 1（X-Forwarded-For 可伪造）
WEB_API_TRUST_FORWARDED=0

# ── 启动行为 ────────────────────────────────────────────────────
# on（默认）=启用本地检索，聊天页签可用，需 bge-m3 + FAISS，实测常驻 3.2 GB
# off=轻量部署：只上图鉴/模拟器/军表三个零 LLM 页签（纯 sqlite + 引擎计算，约 150 MB），
#     聊天页签走诚实降级；模型与索引按设计不需要，前置校验也不会再报它们缺失
WEB_API_RETRIEVAL=on
# 1=启动即后台预加载 bge-m3（首问不用干等冷启动）；检索关掉时此项自动失效
WEB_API_WARMUP=1
# 1=必需资产（模型/索引/结构库）缺失时拒绝启动
WEB_API_PREFLIGHT_STRICT=0

# ── 前端 ────────────────────────────────────────────────────────
# 构建期内联进浏览器包；填**浏览器**能访问的地址，不是 compose 服务名
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── 构建期代理（宿主机 Clash 监听 7897）────────────────────────
# 留空=直连；需要代理时填 http://host.docker.internal:7897
DOCKER_BUILD_PROXY=
