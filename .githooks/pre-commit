#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# .env.example 是唯一该进库的：它是环境变量说明书、只有空占位。先把它滤掉，
# 否则 \.env\. 这一支会把它一起拦下（Stage 5 改这个文件时踩到）。
if git diff --cached --name-only \
  | grep -Ev '(^|/)\.env\.example$' \
  | grep -Eq '(^|/)\.env($|\.|/)|(^|/)\.streamlit/secrets\.toml$'; then
  echo "Blocked: do not commit .env or .streamlit/secrets.toml" >&2
  exit 1
fi

python_cmd=""
if [ -x "./.venv/Scripts/python.exe" ]; then
  python_cmd="./.venv/Scripts/python.exe"
elif command -v python >/dev/null 2>&1; then
  python_cmd="python"
fi

if [ -n "$python_cmd" ]; then
  "$python_cmd" -m py_compile app.py ingest.py hf_embeddings_compat.py
fi
